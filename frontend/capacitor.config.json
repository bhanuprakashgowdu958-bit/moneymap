{
  "appId": "com.moneymap.app",
  "appName": "MoneyMap",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "CapacitorUpdater": {
      "autoUpdate": "off",
      "statsUrl": "",
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    }
  }
}
